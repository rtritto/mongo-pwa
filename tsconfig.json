{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ESNext"
    ],
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "types": [
      "vite/client"
    ]
  },
  "exclude": [
    ".github",
    ".vite",
    ".vscode",
    ".yarn",
    "dist",
    "src/server",
    "src/pages/**/+data.ts"
  ]
}
